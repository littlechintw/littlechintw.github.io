  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.1.1",
    "astro": "^7.4.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "autocorrect-node": "^2.14.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
