{
  "name": "littlechintw.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "new": "node scripts/new-post.mjs",
    "check": "astro check",
    "now": "node scripts/new-now.mjs",
    "lint:zh": "python3 -I scripts/zh-format.py diff src/content/blog src/content/now && autocorrect --lint src/content",
