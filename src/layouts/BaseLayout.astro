---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const SITE_NAME = 'littlechin.tw';
const DEFAULT_IMAGE = 'https://www.gravatar.com/avatar/c87cbee0a4a96655bd7366b56be7a18a?s=512';

const {
  title,
  description,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  jsonLd,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://littlechin.tw');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const canonical = new URL(isHome ? '/' : Astro.url.pathname, site).href;
const fullTitle = isHome ? title : `${title}｜${SITE_NAME}`;
const ogImage = image ? new URL(image, site).href : DEFAULT_IMAGE;
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="https://www.gravatar.com/avatar/c87cbee0a4a96655bd7366b56be7a18a" />
    <link rel="alternate" type="application/rss+xml" title="littlechin.tw 文章" href={new URL('/rss.xml', site).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_TW" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
    <!-- Google AdSense：驗證與放送廣告用，全站每頁載入 -->
    <script
      is:inline
      async
      data-cfasync="false"
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5042600791806925"
      crossorigin="anonymous"
    ></script>
    <Analytics />
  </head>
  <body class="min-h-screen bg-black text-white antialiased">
    <a href="#main" class="skip-link">跳到主要內容</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 50;
    border-radius: 0.5rem;
    background: rgb(196 181 253);
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #000;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
