---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { collectTags, getPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const description = `標記為「${tag}」的文章，共 ${posts.length} 篇。`;
---
<BaseLayout title={`#${tag} 的文章`} description={description}>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-8 lg:px-8">
    <a href="/blog/" class="text-sm text-gray-400 hover:text-violet-200">&larr; 所有文章</a>
    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-violet-300">Tag</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">#{tag}</h1>
    <p class="mt-4 text-base leading-7 text-gray-300">{description}</p>
  </section>
  <section class="mx-auto max-w-6xl px-6 pb-12 lg:px-8" aria-label="文章列表">
    <div class="grid gap-4 sm:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
