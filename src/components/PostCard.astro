---
import type { Post } from '../lib/posts';
import { formatDate, isoDate, postUrl, readingTime, tagUrl } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { minutes } = readingTime(post.body);
---
<article class="post-card">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-400">
    <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>約 {minutes} 分鐘</span>
    {post.data.draft && <span class="rounded-full border border-amber-400/50 px-2 py-0.5 text-amber-300">草稿</span>}
  </div>
  <h3 class="mt-2 text-lg font-semibold leading-snug text-gray-50">
    <a href={postUrl(post)} class="post-card__title" data-ga="post_click" data-ga-label={post.data.title}>{post.data.title}</a>
  </h3>
  <p class="mt-2 text-sm leading-6 text-gray-300">{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="標籤">
      {post.data.tags.map((tag) => (
        <li>
          <a href={tagUrl(tag)} class="tag-chip">#{tag}</a>
        </li>
      ))}
    </ul>
  )}
</article>

<style>
  .post-card {
    position: relative;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.03);
    padding: 1.25rem;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .post-card:hover {
    border-color: rgba(196, 181, 253, 0.8);
    background-color: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }

  .post-card__title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card__title:hover {
    color: rgb(221 214 254);
  }

  .tag-chip {
    position: relative;
    z-index: 1;
    display: inline-flex;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 0.125rem 0.625rem;
    font-size: 0.75rem;
    line-height: 1.25rem;
    color: rgb(209 213 219);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .tag-chip:hover {
    border-color: rgba(196, 181, 253, 0.7);
    color: rgb(221 214 254);
  }
</style>
